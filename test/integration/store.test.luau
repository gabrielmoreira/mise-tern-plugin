-- Failures -----------------------------------------------------------------------------------------------------------
Lib.section("failures are shown, recorded and recoverable")
Store.dispatch(S, "add")
Store.submit(S, { f_add = "definitely-not-a-real-tool-xyz@1" })
local d = S.dialog
Shim.wait_for(function() return d.dry and d.dry.status ~= "loading" end, 30)
check("run reports failure", run_dialog(S, 90))
eq("phase failed", S.dialog.phase, "failed")
check("stderr kept for display", S.dialog.stderr_tail ~= nil and S.dialog.stderr_tail ~= "")
eq("history has the failure", S.history[1].status, "failed")
check("lock released after failure", Shim.kv["mise.lock"] == nil)
