--!nonstrict
-- The store against the real mise, in a throwaway world: reading, previews, installing, adding, removing, tasks,
-- settings, the widget snapshot and stale-answer handling.
local fs = require("@lune/fs")
local Lib = require("../lib")
local Shim = require("../shim")
local World = require("./world")
local check, eq = Lib.check, Lib.eq

local ROOT = Lib.root()
local w = World.new("store")
local Cli = Shim.load(ROOT .. "/misecli.luau")
local Store = Shim.load(ROOT .. "/store.luau")
local Plan = Shim.load(ROOT .. "/plan.luau")
local Model = Shim.load(ROOT .. "/model.luau")

local function new_store(cwd: string)
	Shim.tern.kv.set("mise.focus", { cwd = cwd })
	local S = Store.new({
		redraw = function() end,
		effect = function(_, kind, data) table.insert(Shim.effects, { "effect", kind, data }) end,
	})
	Store.start(S)
	Shim.wait_for(function() return S.setup.status == "ok" or S.setup.status == "missing" end, 40)
	return S
end

local function settled(S, keys: { string }): boolean
	return Shim.wait_for(function()
		for _, k in keys do
			local d = S.ds[k]
			if not d or d.status == "loading" then return false end
		end
		return true
	end, 60)
end

local function row_for(S, tool: string)
	local rows = Store.tool_rows(S)
	for _, r in (rows and rows.requested) or {} do if r.tool == tool then return r end end
	return nil
end

local function run_dialog(S, timeout_s: number?)
	Store.dispatch(S, "plan.run")
	return Shim.wait_for(function() return S.dialog and (S.dialog.phase == "done" or S.dialog.phase == "failed") end, timeout_s or 120)
end

-- Setup ------------------------------------------------------------------------------------------------------------
Lib.section("setup finds mise and its flags")
local proj = w.project("app", '[tools]\njq = "1.7.1"\n')
local S = new_store(proj)
eq("mise found", S.setup.status, "ok")
check("version parsed", Cli.version ~= nil and string.match(Cli.version, "^%d+%.%d+%.%d+$") ~= nil, Cli.version)
check("flag probes saw --dry-run on use", Cli.caps.use_dry_run == true)
check("flag probes saw --no-prune on unuse", Cli.caps.unuse_no_prune == true)
check("flag probes saw --prunable on ls", Cli.caps.ls_prunable == true)

-- Reading ------------------------------------------------------------------------------------------------------------
Lib.section("merged read: a requested tool that is not installed is Missing")
settled(S, { "current", "global", "local", "all" })
local jq = row_for(S, "jq")
check("jq is requested here", jq ~= nil)
eq("and Missing", jq and jq.status.text, "Missing")
eq("request text kept", jq and jq.requested, "1.7.1")
check("the source is this project's mise.toml", jq and jq.source_path and string.find(string.lower(jq.source_path), "app[/\\]mise.toml") ~= nil, jq and jq.source_path)
check("local read agrees", #(Store.data(S, "local") or {}) == 1)
check("global is empty in a fresh world", #(Store.data(S, "global") or {}) == 0)

-- Install: preview then run --------------------------------------------------------------------------------------------
Lib.section("Install missing: reviewed plan with a dry run, then real run")
Store.dispatch(S, "install.missing")
eq("a plan dialog opens", S.dialog and S.dialog.kind, "plan")
eq("argv is exactly `install`", table.concat(S.dialog.plan.argv, " "), "install")
Shim.wait_for(function() return S.dialog.dry and S.dialog.dry.status ~= "loading" end, 30)
eq("dry run answered", S.dialog.dry and S.dialog.dry.status, "ok")
check("dry run did not install", not (Store.data(S, "current") and Store.data(S, "current")[1].installed))
local installed_before = fs.isDir(w.env.MISE_INSTALLS_DIR .. "/jq")
check("no install directory yet", not installed_before)
check("run finishes", run_dialog(S))
eq("phase done", S.dialog.phase, "done")
check("history recorded the run", #S.history == 1 and S.history[1].status == "ok" and string.find(S.history[1].argv, "install", 1, true) ~= nil)
check("history persisted to kv", Shim.kv["mise.history"] ~= nil)
check("jq is on disk", fs.isDir(w.env.MISE_INSTALLS_DIR .. "/jq"))
Store.dispatch(S, "dialog.close")
settled(S, { "current", "all" })
jq = row_for(S, "jq")
eq("jq is Active now", jq and jq.status.text, "Active")
eq("version is concrete", jq and jq.version, "1.7.1")
eq("mutation stamped kv changed", Shim.kv["mise.changed"] ~= nil, true)
eq("lock released", Shim.kv["mise.lock"], nil)

-- Snapshot for the widget ---------------------------------------------------------------------------------------------
Lib.section("snapshot published for the widget")
local snap = Shim.kv[Store.snapshot_key(proj)]
check("snapshot exists for the folder", snap ~= nil)
eq("it lists jq", snap and snap.merged[1].tool, "jq")
settled(S, { "local", "global" })
snap = Shim.kv[Store.snapshot_key(proj)]
eq("the local list is published too", snap.localtools and snap.localtools[1].tool, "jq")
check("and the global list", Shim.kv[Store.GLOBAL_SNAPSHOT] ~= nil and #Shim.kv[Store.GLOBAL_SNAPSHOT].tools == 0)
eq("local widget text", Model.widget_view(snap, Shim.kv[Store.GLOBAL_SNAPSHOT], "local", "counters").text, "1 local")
eq("mixed widget text", Model.widget_view(snap, Shim.kv[Store.GLOBAL_SNAPSHOT], "mixed", "counters").text, "1 local · 0 global")

-- Also installed ------------------------------------------------------------------------------------------------------
Lib.section("installed but not requested here")
local other = w.project("other", "")
Store.set_cwd(S, other)
settled(S, { "current", "all", "global", "local" })
eq("no requested tools in an empty project", #Store.tool_rows(S).requested, 0)
eq("jq listed as also installed", #Store.tool_rows(S).also, 1)
eq("tagged not active here", Store.tool_rows(S).also[1].status.text, "Not active here")
Store.set_cwd(S, proj)
settled(S, { "current", "all" })

-- Add (project) --------------------------------------------------------------------------------------------------------
Lib.section("Add to project: preview names the file it would write")
Store.dispatch(S, "add")
eq("add dialog", S.dialog.kind, "add")
Store.submit(S, { f_add = "  " })
check("empty input is refused in place", S.dialog.kind == "add" and S.dialog.error ~= nil)
Store.submit(S, { f_add = "jq@1.6 extra" })
check("spaces are refused", S.dialog.error ~= nil)
Store.submit(S, { f_add = "jq@1.6" })
eq("becomes a plan", S.dialog.kind, "plan")
check("argv has use then the spec", S.dialog.plan.argv[1] == "use" and S.dialog.plan.argv[#S.dialog.plan.argv] == "jq@1.6", table.concat(S.dialog.plan.argv, " "))
Shim.wait_for(function() return S.dialog.dry and S.dialog.dry.status ~= "loading" end, 30)
check("dry run names the target", S.dialog.target ~= nil and string.find(string.lower(S.dialog.target), "app[/\\]mise.toml") ~= nil, S.dialog.target)
local before = fs.readFile(proj .. "/mise.toml")
check("config untouched by the preview", string.find(before, "1.7.1", 1, true) ~= nil and not string.find(before, "1.6", 1, true))
check("run", run_dialog(S))
local after = fs.readFile(proj .. "/mise.toml")
check("config now requests 1.6", string.find(after, '"1.6"', 1, true) ~= nil or string.find(after, "1.6", 1, true) ~= nil, after)
Store.dispatch(S, "dialog.close")
settled(S, { "current", "all" })
jq = row_for(S, "jq")
eq("project now wants 1.6", jq and jq.requested, "1.6")
eq("1.7.1 stays installed, not requested", #Store.tool_rows(S).also, 1)

-- Remove ------------------------------------------------------------------------------------------------------------
Lib.section("Uninstall guard and config removal")
Store.dispatch(S, "remove.open", jq.id)
eq("remove dialog", S.dialog.kind, "remove")
Store.dispatch(S, "remove.uninstall")
check("active version cannot be uninstalled", S.dialog.kind == "remove" and S.dialog.error ~= nil, S.dialog.error)
Store.dispatch(S, "remove.config")
eq("unuse plan", S.dialog.plan.id, "unuse")
check("unuse targets this config", string.find(table.concat(S.dialog.plan.argv, " "), "--path", 1, true) ~= nil)
check("run", run_dialog(S))
Store.dispatch(S, "dialog.close")
check("config no longer requests jq", not string.find(fs.readFile(proj .. "/mise.toml"), "jq", 1, true), fs.readFile(proj .. "/mise.toml"))
settled(S, { "current", "all" })
eq("jq 1.7.1 is installed and requested nowhere", #Store.tool_rows(S).requested, 0)
local also = Store.tool_rows(S).also
local target
for _, r in also do if r.version == "1.7.1" then target = r end end
check("it is listed as also installed", target ~= nil)
Store.dispatch(S, "remove.open", target.id)
Store.dispatch(S, "remove.uninstall")
eq("uninstall plan is dangerous", S.dialog.plan.danger, true)
Shim.wait_for(function() return S.dialog.dry and S.dialog.dry.status ~= "loading" end, 30)
eq("first run press only asks to confirm", (function() Store.dispatch(S, "plan.run") return S.dialog.phase end)(), "review")
check("confirm flag set", S.dialog.confirm == true)
check("final run", run_dialog(S))
Store.dispatch(S, "dialog.close")
check("version directory is gone", not fs.isDir(w.env.MISE_INSTALLS_DIR .. "/jq/1.7.1"))

-- Tasks ------------------------------------------------------------------------------------------------------------
Lib.section("tasks")
local tproj = w.project("tasks", '[tasks.build]\ndescription = "Build the app"\nrun = "echo built"\n[tasks.test]\nrun = "echo tested"\n')
Store.set_cwd(S, tproj)
Store.dispatch(S, "tab", "tasks")
settled(S, { "tasks" })
local list = Store.task_list(S)
eq("two tasks", #list, 2)
eq("alphabetical with a group", list[1].name .. "/" .. list[1].group, "build/All tasks")
Shim.effects = {}
Store.dispatch(S, "task.open", "build")
eq("task dialog", S.dialog.kind, "task")
Store.submit(S, { f_args = "--flag 'two words'" })
local ran
for _, e in Shim.effects do if e[1] == "effect" and e[2] == "task.run" then ran = e[3] end end
check("task.run effect emitted", ran ~= nil)
eq("with its folder", ran and ran.cwd, tproj)
eq("and raw args", ran and ran.args, "--flag 'two words'")
eq("recent updated", Shim.kv["mise.recent"] ~= nil, true)
list = Store.task_list(S)
eq("recent group first", list[1].group, "Recent in this project")
eq("run task is first", list[1].name, "build")
eq("no duplicate", #list, 2)
local split = Store.split_args("--flag 'two words' \"x y\" z")
eq("split args", table.concat(split, "|"), "--flag|two words|x y|z")

-- Task authoring --------------------------------------------------------------------------------------------------------
Lib.section("create a task by writing its table, then having mise read it back")
local tfile = tproj .. "/mise.toml"
Store.dispatch(S, "tab", "tasks")
settled(S, { "tasks" })
Store.dispatch(S, "task.new")
eq("form opens", S.dialog.kind, "taskform")
Store.submit(S, { f_t_name = "", f_t_run = "echo hi" })
check("name is required", S.dialog.error ~= nil and S.dialog.kind == "taskform")
Store.submit(S, { f_t_name = "bad name", f_t_run = "echo hi" })
check("no spaces in names", S.dialog.error ~= nil)
Store.submit(S, { f_t_name = "build", f_t_run = "echo hi" })
check("duplicate names refused", S.dialog.error ~= nil and string.find(S.dialog.error, "already exists", 1, true) ~= nil)
Store.submit(S, { f_t_name = "hello", f_t_run = "" })
check("command required", S.dialog.error ~= nil)
Store.dispatch(S, "taskform.bool", "quiet")
Store.submit(S, { f_t_name = "hello", f_t_run = "echo \"hi there\" && echo 'x'", f_t_description = "Say hi", f_t_depends = "build, test", f_t_dir = "" })
eq("review plan", S.dialog.kind, "plan")
local added = table.concat(S.dialog.plan.file_edit.diff, "\n")
check("the review shows the table that will be appended", string.find(added, "+ [tasks.hello]", 1, true) and string.find(added, '+ description = "Say hi"', 1, true) and string.find(added, '+ depends = ["build", "test"]', 1, true) and string.find(added, "+ quiet = true", 1, true), added)
check("it goes to the folder's own mise.toml", Model.same_path(S.dialog.plan.file_edit.path, tfile, S.windows), S.dialog.plan.file_edit.path)
Store.dispatch(S, "plan.back")
eq("Back returns to the form", S.dialog.kind, "taskform")
Store.submit(S, { f_t_name = "hello", f_t_run = "echo \"hi there\" && echo 'x'", f_t_description = "Say hi", f_t_depends = "build, test", f_t_dir = "" })
check("run", run_dialog(S))
eq("created", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
local created = fs.readFile(tfile)
check("file has the table", string.find(created, "[tasks.hello]", 1, true) ~= nil, created)
check("the command is written as typed, not shell-quoted", string.find(created, [[run = "echo \"hi there\" && echo 'x'"]], 1, true) ~= nil, created)
check("what was already in the file is untouched", string.find(created, 'run = "echo built"', 1, true) ~= nil)
settled(S, { "tasks" })
check("listed", Store.task(S, "hello") ~= nil)
eq("script flag false for toml tasks", Store.task(S, "hello").toml, true)

Lib.section("edit a task: only changed lines are rewritten")
fs.writeFile(tfile, fs.readFile(tfile) .. "\n# keep me\n[tasks.hello.env]\nFOO = \"bar\"\n")
Store.dispatch(S, "refresh")
settled(S, { "tasks" })
Store.dispatch(S, "task.select", "hello")
check("source loaded for the selection", S.task_src and S.task_src.block and S.task_src.block.kind == "table")
Store.dispatch(S, "task.edit", "hello")
eq("edit form", S.dialog.kind, "taskform")
eq("prefilled from the file", S.dialog.prefill.f_t_description, "Say hi")
eq("quiet loaded", S.dialog.bools.quiet, true)
Store.submit(S, { f_t_run = S.dialog.prefill.f_t_run, f_t_description = "Say hi", f_t_depends = "build, test" })
check("no changes is reported", S.dialog.kind == "taskform" and S.dialog.error == "Nothing changed.", S.dialog.error)
Store.submit(S, { f_t_run = S.dialog.prefill.f_t_run, f_t_description = "Greet", f_t_depends = "build, test", f_t_dir = "sub" })
eq("review", S.dialog.kind, "plan")
local diff = table.concat(S.dialog.plan.file_edit.diff, "\n")
check("diff shows exactly the changes", string.find(diff, '- description = "Say hi"', 1, true) and string.find(diff, '+ description = "Greet"', 1, true) and string.find(diff, '+ dir = "sub"', 1, true), diff)
check("preview did not write", string.find(fs.readFile(tfile), "Say hi", 1, true) ~= nil)
check("run edit", run_dialog(S))
eq("saved", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
local edited = fs.readFile(tfile)
check("description changed", string.find(edited, 'description = "Greet"', 1, true) ~= nil, edited)
check("comment and sub-table kept", string.find(edited, "# keep me", 1, true) ~= nil and string.find(edited, 'FOO = "bar"', 1, true) ~= nil)
check("other tasks untouched", string.find(edited, "[tasks.build]", 1, true) ~= nil and string.find(edited, 'run = "echo built"', 1, true) ~= nil)
check("history names the file edit", string.find(S.history[1].argv, "[tasks.hello]", 1, true) ~= nil)

Lib.section("a file mise cannot read is rolled back")
settled(S, { "tasks" })
Store.dispatch(S, "task.edit", "hello")
Store.submit(S, { f_t_run = S.dialog.prefill.f_t_run, f_t_description = "Greet", f_t_depends = "build, test", f_t_dir = "sub", f_t_alias = "h" })
local good = fs.readFile(tfile)
-- Corrupt the plan's text so mise cannot parse it: the plugin must put the old file back.
S.dialog.plan.file_edit.after = good .. "\n[tasks.hello\nbroken ===\n"
check("run broken edit", run_dialog(S))
eq("reported as failed", S.dialog.phase, "failed")
eq("file restored byte for byte", fs.readFile(tfile), good)
check("stderr/message explains", string.find(S.dialog.stderr_tail or "", "restored", 1, true) ~= nil, S.dialog.stderr_tail)
Store.dispatch(S, "dialog.close")

Lib.section("a file changed under the dialog is not overwritten")
settled(S, { "tasks" })
Store.dispatch(S, "task.edit", "hello")
Store.submit(S, { f_t_run = S.dialog.prefill.f_t_run, f_t_description = "Other", f_t_depends = "build, test", f_t_dir = "sub" })
fs.writeFile(tfile, fs.readFile(tfile) .. "# edited elsewhere\n")
check("run", run_dialog(S))
eq("refused", S.dialog.phase, "failed")
check("external edit survives", string.find(fs.readFile(tfile), "edited elsewhere", 1, true) ~= nil and not string.find(fs.readFile(tfile), '"Other"', 1, true))
Store.dispatch(S, "dialog.close")

Lib.section("a multi-line command is created and edited as a script")
local script = "set -e\necho one\nif true; then\n  echo two\nfi"
Store.dispatch(S, "task.new")
Store.submit(S, { f_t_name = "multiline", f_t_run = script })
eq("review", S.dialog.kind, "plan")
check("run create", run_dialog(S))
eq("created", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
settled(S, { "tasks" })
Store.dispatch(S, "task.select", "multiline")
Store.dispatch(S, "task.edit", "multiline")
eq("form shows the whole script", S.dialog.prefill.f_t_run, script)
Store.submit(S, { f_t_run = script .. "\necho three", f_t_description = "" })
eq("review edit", S.dialog.kind, "plan")
check("run edit", run_dialog(S))
eq("saved", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
local ml = fs.readFile(tfile)
check("script kept readable in the file", string.find(ml, "  echo two\nfi\necho three", 1, true) ~= nil, ml)
settled(S, { "tasks" })
check("mise still lists it after the rewrite", Store.task(S, "multiline") ~= nil)

Lib.section("a folder without a config gets a new mise.toml, trusted")
local bare = w.root .. "/bare"
fs.writeDir(bare)
Store.set_cwd(S, bare)
settled(S, { "tasks", "config" })
Store.dispatch(S, "task.new")
Store.submit(S, { f_t_name = "first", f_t_run = "echo a && echo b" })
eq("review", S.dialog.kind, "plan")
check("plan says it creates the file", S.dialog.plan.file_edit.new_file == true and string.find(S.dialog.plan.effects[1], "Creates mise.toml", 1, true) ~= nil, S.dialog.plan.effects[1])
check("nothing is written during review", not fs.isFile(bare .. "/mise.toml"))
check("run create", run_dialog(S))
eq("created", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
check("file has just the table", fs.readFile(bare .. "/mise.toml") == '[tasks.first]\nrun = "echo a && echo b"\n', fs.readFile(bare .. "/mise.toml"))
settled(S, { "tasks" })
check("mise lists the task, so the file is trusted", Store.task(S, "first") ~= nil)
Store.set_cwd(S, tproj)
settled(S, { "tasks" })

Lib.section("locked values and delete")
fs.writeFile(tfile, '[tasks.multi]\nrun = [\n  "echo a",\n  "echo b",\n]\ndescription = "Two"\n\n[tasks.keep]\nrun = "echo k"\n')
Store.dispatch(S, "refresh")
settled(S, { "tasks" })
Store.dispatch(S, "task.edit", "multi")
eq("edit form for multi", S.dialog.kind, "taskform")
eq("run is locked", S.dialog.form.locked.run, "multi-line value")
Store.submit(S, { f_t_run = "ignored", f_t_description = "Two edited" })
eq("review", S.dialog.kind, "plan")
local d2 = table.concat(S.dialog.plan.file_edit.diff, "\n")
check("only the description changes", not string.find(d2, "echo", 1, true) and string.find(d2, "Two edited", 1, true) ~= nil, d2)
Store.dispatch(S, "dialog.close")
Store.dispatch(S, "task.delete", "multi")
eq("delete is a dangerous plan", S.dialog.plan.danger, true)
Store.dispatch(S, "plan.run")
check("needs confirmation", S.dialog.confirm == true and S.dialog.phase == "review")
check("delete runs", run_dialog(S))
eq("deleted", S.dialog.phase, "done")
Store.dispatch(S, "dialog.close")
local left = fs.readFile(tfile)
check("only the other task remains", not string.find(left, "multi", 1, true) and string.find(left, "[tasks.keep]", 1, true) ~= nil, left)

