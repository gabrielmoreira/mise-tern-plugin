-- Stale answers ------------------------------------------------------------------------------------------------------
Lib.section("an answer for a folder the user left is dropped")
local S2 = new_store(proj)
Store.set_cwd(S2, tproj)
Store.set_cwd(S2, other)
settled(S2, { "current" })
eq("state reflects the last folder", S2.cwd, other)
eq("current read belongs to it", #(Store.data(S2, "current") or {}), 0)

Shim.settle(30)
w.cleanup()
Lib.finish()
